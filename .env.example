# Nijer computer e chalate chaile: cp .env.example .env
# (Render e .env lage na, Render er Environment page e ei value gulo boshabe)

PORT=3000
MAX_FILE_MB=500

# Bucket er naam
GCS_BUCKET=your-bucket-name

# Upload korar password (jei kono ekta shokto password dao)
APP_PASSWORD=change-me

# Local e: service account key file er path
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Render e: key file er puro content (JSON) ekhane paste korte hobe
# GCS_CREDENTIALS_JSON=
